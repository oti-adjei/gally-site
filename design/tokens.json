  "typography": {
    "display": {
      "family": "Noi Grotesk",
      "fallback": "Trebuchet MS, system-ui, sans-serif",
      "weight": 600,
      "tracking": "-0.045em"
    },
    "body": {
      "family": "Fusion Neue",
      "fallback": "system-ui, -apple-system, sans-serif",
      "weight": 400
    },
    "numbers": {
      "family": "SFMono-Regular, Consolas, Liberation Mono, monospace",
      "features": [
        "tnum",
        "lnum"
      ]
    },
    "scale": {
      "caption": 12,
      "label": 14,
      "body": 16,
      "bodyLarge": 18,
      "titleSmall": 20,
      "title": 28,
      "display": 36,
      "amount": 40
    },
    "lineHeight": {
      "body": 1.55,
      "heading": 1.1
    }
  },
  "spacing": [
    0,
    4,
    8,
    16,
    24,
    32,
    40,
    48,
    64,
    80
  ],
  "radius": {
    "small": 8,
    "medium": 16,
    "large": 24,
    "pill": 999
  },
  "elevation": {
    "flat": "none",
    "sheet": "0 -8px 40px #0A1B1426"
  },
  "motion": {
    "enterMs": 200,
    "exitMs": 140,
    "easingEnter": "cubic-bezier(0,0,0.2,1)",
    "easingExit": "cubic-bezier(0.4,0,1,1)",
    "reducedMotionMs": 0,
    "splash": {
      "totalMs": 900,
      "markEnterMs": 360,
      "wordEnterMs": 300,
      "wordDelayMs": 160,
      "taglineEnterMs": 200,
      "taglineDelayMs": 320,
      "exitMs": 140,
      "exitDelayMs": 760,
      "reducedMotion": "skip to ready destination"
    },
    "sharedInteractions": {
      "enterMs": 220,
      "exitMs": 140,
      "stateMs": 180,
      "contentRevealMs": 360,
      "staggerMs": 40,
      "translateEnterPx": 8,
      "translateSheetPx": 16,
      "translateExitPx": 12,
      "easeEnter": "cubic-bezier(0.16,1,0.3,1)",
      "easeExit": "cubic-bezier(0.4,0,1,1)",
      "animatedProperties": [
        "transform",
        "opacity"
      ],
      "financialAmountInterpolation": false,
      "reducedMotion": "instant state updates; no entrance, scroll reveals or animated exits",
      "loading": "actual operations only; no artificial wait"
    }
  },
  "touchTarget": 48,
  "grid": 8,
  "componentSystem": {
    "name": "Gally custom",
    "platforms": [
      "iOS",
      "Android"
    ],
    "materialRoleMapping": "optional interoperability only",
    "nativeSurfaces": [
      "permissions",
      "document picker",
      "share sheet",
      "system navigation"
    ],
    "minimumTarget": 48,
    "onboarding": {
      "displaySize": 40,
      "maximumNameLength": 32,
      "steps": [
        "name and currency",
        "starting priority",
        "first account",
        "confirmation"
      ],
      "resumable": true,
      "requiredPersonalFields": [],
      "desktop": {
        "breakpointPx": 1024,
        "layout": "single full-height split, 42% context/art/progress and 58% form",
        "headerPx": 64,
        "duplicateSummary": false,
        "actions": "dedicated footer row",
        "heightTierPx": 800,
        "accessibleScrollFallbackMaxHeightPx": 660,
        "targetViewports": [
          "1366x768",
          "1440x900",
          "1920x1080"
        ],
        "renderedFitVerified": false
      }
    },
    "stateSemantics": {
      "loading": "actual local work only",
      "success": "after committed state; distinguish session-only storage",
      "warning": "neutral surface with explicit explanation",
      "financialError": "error colour plus status words",
      "pending": "blue-grey, dashed boundary and expected label"
    },
    "planning": {
      "subscriptionCycles": [
        "weekly",
        "monthly",
        "yearly"
      ],
      "budgetScopes": [
        "overall",
        "category"
      ],
      "budgetPeriods": [
        "weekly",
        "monthly",
        "custom"
      ],
      "rollover": "positive unused limits only; derived from completed periods",
      "conversation": "guided questions and local calculations; no live model",
      "voice": "typed transcript preview in browser; on-device speech native dependency"
    },
    "mote": {
      "runtime": "@usemote/core@0.1.1",
      "pack": "@usemote/pack-fintech@0.1.1",
      "localBundle": "assets/vendor/mote/mote-fintech.js",
      "adapter": "mote-fields.js",
      "mode": "bob",
      "theme": "Gally custom colour stops",
      "currencyVariant": "\u20b5",
      "pausedPreferenceKey": "gally-background-motion",
      "reducedMotion": "static and paused; system takes priority",
      "mobileMaxCount": 3,
      "dataAccess": "none"
    }
  },
  "companion": {
    "name": "Pip",
    "defaultStyle": "quiet",
    "styles": [
      "calm",
      "warm",
      "direct",
      "curious"
    ],
    "responseStyleSnapshot": true,
    "mode": "guided-local-prototype",
    "financialConfirmationRequired": true,
    "characters": [
      "quiet",
      "guy",
      "girl",
      "coach"
    ],
    "classicStyles": [
      "calm",
      "warm",
      "direct",
      "curious"
    ],
    "states": [
      "ready",
      "listening",
      "review",
      "thinking",
      "replying",
      "interrupted",
      "unavailable"
    ],
    "simulatedStatesLabelled": true,
    "visualCharacter": {
